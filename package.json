{
  "name": "luminous-topology-panel",
  "version": "1.4.407",
  "description": "Topology Panel — Grafana panel for network maps with Zabbix status, links and submaps",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.js --env production && bash .config/build-backend.sh",
    "build:backend": "bash .config/build-backend.sh",
    "dev": "bash .config/dev.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && go test ./pkg/...",
    "test:watch": "vitest",
    "version:bump": "node .config/bump-plugin-version.mjs",
    "changelog:notes": "node .config/changelog-notes.mjs",
    "pack:store": "bash packaging/build-store-zip.sh",
    "pack:private": "bash packaging/build-private-zip.sh"
  },
  "author": "Luminous Telecom",
  "license": "SEE LICENSE IN EULA.md",
  "devDependencies": {
    "@grafana/data": "^11.0.0",
    "@grafana/runtime": "^11.0.0",
    "@grafana/schema": "^11.0.0",
    "@grafana/ui": "^11.0.0",
    "@swc/core": "^1.7.0",
    "@swc/helpers": "^0.5.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "jsdom": "^26.1.0",
    "react-icons": "^5.5.0",
    "sass": "^1.103.1",
    "sass-loader": "^16.0.8",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.0"
  },
  "peerDependencies": {
    "@grafana/data": "*",
    "@grafana/runtime": "*",
    "@grafana/ui": "*",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
