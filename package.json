{
  "name": "luminous-topology-panel",
  "version": "1.4.206",
  "description": "Topology Panel — Grafana panel for network maps with Zabbix status, links and submaps",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.js --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.js --env development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "bash scripts/deploy.sh homolog",
    "deploy:prod": "bash scripts/deploy.sh prod"
  },
  "author": "Luminous Telecom",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/data": "^11.0.0",
    "@grafana/runtime": "^11.0.0",
    "@grafana/schema": "^11.0.0",
    "@grafana/ui": "^11.0.0",
    "@swc/core": "^1.7.0",
    "@swc/helpers": "^0.5.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "copy-webpack-plugin": "^12.0.0",
    "dagre": "^0.8.5",
    "jsdom": "^26.1.0",
    "react-icons": "^5.5.0",
    "swc-loader": "^0.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.0"
  },
  "peerDependencies": {
    "@grafana/data": "*",
    "@grafana/runtime": "*",
    "@grafana/ui": "*",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
